{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "mgs",
      "camelcase": "Mgs",
      "title": "MGS",
      "scope": "source.mgs",
      "file-types": [
        "mgs"
      ],
      "injection-regex": "^mgs$",
      "class-name": "TreeSitterMgs",
      "highlights": [
        "queries/highlights.scm"
      ]
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Mgs grammar for tree-sitter",
    "authors": [
      {
        "name": "Michael Shepherd",
        "email": "michaelshep1504@gmail.com",
        "url": ""
      }
    ],
    "links": {
      "repository": "https://github.com/tree-sitter/tree-sitter-mgs",
      "funding": ""
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
